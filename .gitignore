# 遊戲本體與衍生資源(絕不入 git,patch-only)
resource.*
RESOURCE.*
*.drv
*.DRV
*.hep
*.scr
# 例外:dist-cht/271.* 是本專案自己用 tools/build_room271.py 組出來的,不是 Sierra 的資源。
# 上面兩條是為了擋遊戲目錄裡的 335.scr / 390.hep 那類原始資源,把這兩個一起吞掉了——
# 結果是它們從沒進過 git,macOS CI(從 repo checkout 打包)因此少檔,靠打包腳本的
# 檔案清單 guard 才抓到。
!dist-cht/271.scr
!dist-cht/271.hep
sierra.exe
sciwv.exe
*.ROM
game/
game_extract/
*.iso
*.zip
*.rar

# 倚天原始字型檔(整套 13094 字的商業字庫)不入庫;
# dist-cht/ 下只放「本作用到的 2141 字」烘出來的子集,隨補丁散布
tools/assets/eten/

# 手冊掃描(© 軟體世界,不推公開 repo)
manual/
*.jpg
*.jpeg

# build 產物與大型來源
scummvm-src/
scummvm-win/
build/
out/
dist-all/
dist-cht-open/
extract/
__pycache__/
*.o
*.pyc

# 推廣片素材與成品:含遊戲畫面與原版配樂(他人著作權),不入公開 repo
out/
video/
video_src/
*.mp4
*.wav
*.raw
